# POKRABS Backend Dockerfile
# Multi-stage build to reduce final image size

# Stage 1: Build dependencies (with build tools)
FROM node:20-alpine AS builder

# Install build tools needed for better-sqlite3 native compilation
RUN apk add --no-cache python3 make g++

WORKDIR /app/backend

# Copy package files and install dependencies
COPY backend/package*.json ./
RUN npm ci --production

# Stage 2: Production image (without build tools)
FROM node:20-alpine

# Install only Prisma CLI (needed for db push at runtime)
RUN apk add --no-cache openssl

WORKDIR /app/backend

# Copy only production dependencies from builder
COPY --from=builder /app/backend/node_modules ./node_modules

# Copy built backend code
COPY backend/dist ./dist
COPY backend/migrations ./migrations

# Copy only schema.prisma (not the entire prisma directory with all platform binaries)
COPY backend/prisma/schema.prisma ./prisma/schema.prisma

# Copy compiled shared directory
COPY shared ./node_modules/shared

# Create data directory for SQLite
RUN mkdir -p /app/data

# Set default environment variables
ENV DATABASE_TYPE=sqlite
ENV DATABASE_URL=file:./data/pokrabs.db
ENV PORT=3001
ENV NODE_ENV=production

# Generate Prisma client (only for Alpine Linux, not all platforms)
RUN npx prisma generate

EXPOSE 3001

# Start the backend
CMD ["node", "dist/backend/src/index.js"]
