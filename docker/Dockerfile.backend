# POKRABS Backend Dockerfile
# Multi-stage build to reduce final image size
# Supports both amd64 (x86) and arm64 architectures
# For multi-arch builds, use: docker buildx build --platform linux/amd64,linux/arm64

# Stage 1: Build dependencies (with build tools)
FROM node:20-alpine AS builder

# Install build tools needed for better-sqlite3 native compilation
RUN apk add --no-cache python3 make g++

WORKDIR /app

# Copy package files and install ALL dependencies (including dev dependencies for building)
COPY package*.json ./
COPY backend/package*.json ./backend/
RUN cd backend && npm ci

# Copy source code and shared directory
COPY backend/ ./backend/
COPY shared/ ./shared/

# Create a simple tsconfig for Docker build
RUN echo '{"compilerOptions": {"target": "ES2022", "module": "commonjs", "lib": ["ES2022"], "outDir": "./backend/dist", "strict": true, "esModuleInterop": true, "skipLibCheck": true, "forceConsistentCasingInFileNames": true, "resolveJsonModule": true, "moduleResolution": "node", "declaration": true, "declarationMap": true, "sourceMap": true}, "include": ["backend/src/**/*", "shared/**/*"], "exclude": ["**/node_modules", "**/dist", "**/*.test.ts"]}' > tsconfig.docker.json

# Build the TypeScript code from project root
RUN ./backend/node_modules/.bin/tsc --project tsconfig.docker.json

# Stage 2: Production image (without build tools)
FROM node:20-alpine

# Install only Prisma CLI (needed for db push at runtime)
RUN apk add --no-cache openssl

WORKDIR /app/backend

# Copy only production dependencies from builder
# Native modules (better-sqlite3) are already compiled for the target platform
COPY --from=builder /app/backend/node_modules ./node_modules

# Copy package.json (needed for Prisma to generate client correctly)
COPY backend/package*.json ./

# Copy built backend code
COPY backend/dist ./dist
COPY backend/migrations ./migrations

# Copy only schema.prisma (not the entire prisma directory with all platform binaries)
COPY backend/prisma/schema.prisma ./prisma/schema.prisma

# Copy compiled shared directory
COPY shared ./node_modules/shared

# Create data directory for SQLite
RUN mkdir -p /app/data

# Set default environment variables
ENV DATABASE_TYPE=sqlite
ENV DATABASE_URL=file:./data/pokrabs.db
ENV PORT=3001
ENV NODE_ENV=production

# Generate Prisma client (only for Alpine Linux, not all platforms)
# Remove any existing Prisma client first to ensure clean generation
RUN rm -rf ./node_modules/.prisma ./node_modules/@prisma/client && \
    npx prisma generate

EXPOSE 3001

# Start the backend
CMD ["node", "dist/backend/src/index.js"]
