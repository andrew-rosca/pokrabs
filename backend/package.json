{
  "name": "pokrabs-backend",
  "version": "1.0.0",
  "description": "POKRABS backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "db:setup": "prisma db push --accept-data-loss && prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:push": "prisma db push",
    "db:seed": "tsx src/database/seed.ts",
    "db:seed:large": "tsx src/database/seed.ts --large"
  },
  "keywords": [],
  "author": "",
