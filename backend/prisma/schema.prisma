// POKRABS Prisma Schema
// 
// This schema is database-agnostic and works with SQLite, PostgreSQL, MySQL, etc.
// Prisma will generate the appropriate migrations based on the provider specified.
//
// To change databases, just change the `provider` in the datasource block.
// Prisma handles all the database-specific SQL generation.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite" // Can be changed to "postgresql" or "mysql"
  url      = env("DATABASE_URL")
}

/**
 * Organizations Table
 * Organizations are top-level containers for users and workspaces.
 * All data (workspaces, problems, views) belongs to an organization.
 */
model Organization {
  /// Unique identifier for the organization (UUID)
  id String @id

  /// Organization name
  name String

  /// Timestamp when organization was created
  createdAt DateTime @default(now())

  /// Timestamp when organization was last updated
  updatedAt DateTime @updatedAt

  /// Related users
  users User[]

  /// Related workspaces
  workspaces Workspace[]

  /// Related problems
  problems Problem[]

  /// Related views
  views View[]

  @@map("organizations")
}

/**
 * Users Table
 * Users belong to an organization and can authenticate via OAuth providers.
 */
model User {
  /// Unique identifier for the user (UUID)
  id String @id

  /// Organization ID (required - every user belongs to an organization)
  organizationId String

  /// OAuth provider user ID (e.g., Google user ID)
  authId String?

  /// OAuth provider name (e.g., "google", "github", "microsoft")
  authProvider String?

  /// User email address
  email String

  /// User display name
  name String

  /// Timestamp when user was created
  createdAt DateTime @default(now())

  /// Timestamp when user was last updated
  updatedAt DateTime @updatedAt

  /// Relationship to organization
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Related votes
  votes Vote[]

  @@unique([authId, authProvider])
  @@index([organizationId])
  @@index([authId, authProvider])
  @@map("users")
}

/**
 * Workspaces Table
 * Workspaces are top-level containers for problems.
 * Each problem belongs to exactly one workspace.
 */
model Workspace {
  /// Unique identifier for the workspace (2+ chars, e.g., "a2", "df", "7f1")
  id String @id

  /// Organization ID (required - every workspace belongs to an organization)
  organizationId String

  /// Workspace name
  name String

  /// Timestamp when workspace was created
  createdAt DateTime @default(now())

  /// Timestamp when workspace was last used (for sorting by most recent)
  lastUsedAt DateTime @default(now())

  /// Soft delete timestamp (null means not deleted)
  deletedAt DateTime?

  /// Relationship to organization
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Related problems
  problems Problem[]

  /// Related views
  views View[]

  @@index([organizationId])
  @@index([deletedAt])
  @@index([lastUsedAt])
  @@index([organizationId, deletedAt])
  @@map("workspaces")
}

/**
 * Problems Table
 * Problems are the core entities in POKRABS.
 * They form a hierarchical tree structure within a workspace.
 */
model Problem {
  /// Unique identifier for the problem (2+ chars, e.g., "a2", "df", "7f1")
  /// Does NOT contain the hierarchical path (that's in idPath)
  id String @id

  /// Full hierarchical path from root (e.g., "a2-df-7f")
  /// Root: idPath = id, Child: idPath = parent's idPath + "-" + id
  idPath String

  /// Problem definition as JSON: { summary: string, detail: string }
  /// summary: Brief summary, detail: Detailed description with markdown
  problem String @default("{\"summary\": \"\", \"detail\": \"\"}")

  /// Objective definition as JSON: { summary: string, detail: string }
  /// summary: Brief summary, detail: Detailed description with markdown
  objective String @default("{\"summary\": \"\", \"detail\": \"\"}")

  /// Key Results - JSON array of measurable, objective success criteria
  keyResults String @default("[]")

  /// Actions - JSON array of action items (can contain hyperlinks)
  actions String @default("[]")

  /// Blockers - JSON array of blockers (can reference child problems)
  /// Empty array = no blockers = actionable
  blockers String @default("[]")

  /// Status enum (values match shared/types.ts Status enum)
  /// Note: Prisma stores enum names, but we map them to match shared/types.ts values
  status ProblemStatus @default(NotStarted)

  /// Vote count
  votes Int @default(0)

  /// Priority for manual sorting (lower = higher priority)
  priority Int @default(0)

  /// Labels - JSON array
  labels String @default("[]")

  /// Parent Problem ID (null for root problems)
  parentId String?

  /// Workspace ID (required - every problem belongs to a workspace)
  workspaceId String

  /// Organization ID (required - every problem belongs to an organization)
  organizationId String

  /// Timestamp when problem was created
  createdAt DateTime @default(now())

  /// Timestamp when problem was last updated
  updatedAt DateTime @updatedAt

  /// Soft delete timestamp (null means not deleted)
  deletedAt DateTime?

  /// Self-referential relationship: parent problem
  parent   Problem?  @relation("ProblemHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children Problem[] @relation("ProblemHierarchy")

  /// Relationship to workspace
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// Relationship to organization
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Related votes
  voteRecords Vote[]

  @@index([workspaceId])
  @@index([organizationId])
  @@index([parentId])
  @@index([deletedAt])
  @@index([workspaceId, deletedAt])
  @@index([organizationId, deletedAt])
  @@index([status])
  @@index([priority])
  @@index([votes])
  @@map("problems")
}

/// Problem Status Enum
/// Values match the Status enum in shared/types.ts
enum ProblemStatus {
  NotStarted @map("Actionable")
  InProgress @map("In Progress")
  Blocked
  Resolved
}

/**
 * Views Table
 * Saved filter combinations for a workspace.
 * Each view stores filter state (statuses, labels) and can be quickly switched.
 */
model View {
  /// Unique identifier for the view (2+ chars, e.g., "a2", "df", "7f1")
  id String @id

  /// Workspace ID (required - every view belongs to a workspace)
  workspaceId String

  /// Organization ID (required - every view belongs to an organization)
  organizationId String

  /// View name
  name String

  /// Filter configuration as JSON: { selectedStatuses: string[], selectedLabels: string[] }
  filters String @default("{}")

  /// Timestamp when view was last used (for sorting by most recent)
  lastUsedAt DateTime @default(now())

  /// Whether this is the default view (created at system initialization)
  isDefault Boolean @default(false)

  /// Timestamp when view was created
  createdAt DateTime @default(now())

  /// Timestamp when view was last updated
  updatedAt DateTime @updatedAt

  /// Soft delete timestamp (null means not deleted)
  deletedAt DateTime?

  /// Relationship to workspace
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// Relationship to organization
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([organizationId])
  @@index([deletedAt])
  @@index([workspaceId, deletedAt])
  @@index([organizationId, deletedAt])
  @@index([workspaceId, lastUsedAt])
  @@map("views")
}

/**
 * Votes Table
 * Tracks individual user votes on problems.
 * A user can cast multiple votes on the same problem (dot voting).
 */
model Vote {
  /// Unique identifier for the vote (UUID)
  id String @id

  /// User ID (required - who cast this vote)
  userId String

  /// Problem ID (required - what problem this vote is for)
  problemId String

  /// Number of votes the user has cast on this problem
  count Int @default(1)

  /// Timestamp when vote was created
  createdAt DateTime @default(now())

  /// Timestamp when vote was last updated
  updatedAt DateTime @updatedAt

  /// Relationship to user (cascade delete when user is deleted)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Relationship to problem (cascade delete when problem is deleted)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  /// Each user can only have one vote record per problem (but count can be > 1)
  @@unique([userId, problemId])
  @@index([userId])
  @@index([problemId])
  @@map("votes")
}

/**
 * ID Counter Table
 * Stores the global counter for LCG-based ID generation.
 * Single row table - only one counter exists.
 */
model IdCounter {
  /// Singleton key (always "global")
  id String @id @default("global")

  /// Current counter value (increments with each ID generated)
  counter Int @default(0)

  /// Current ID length (starts at 2, expands when space exhausted)
  length Int @default(2)

  @@map("id_counter")
}
