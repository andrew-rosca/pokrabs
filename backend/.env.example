# Database Configuration
DATABASE_TYPE=sqlite
DATABASE_URL=./data/pokrabs.db

# Server Configuration
PORT=3001
NODE_ENV=development

# Test Mode (for testing)
TEST_MODE=false

# Authentication Configuration
# Set AUTH_MODE to one of: 'demo', 'optional', 'required'
# - demo: No authentication required, uses default seeded user
# - optional: Authentication required for write operations (POST, PATCH, DELETE) and voting
# - required: Authentication required for all operations including browsing
AUTH_MODE=demo

# Google OAuth Configuration (required when AUTH_MODE is not 'demo')
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# Session Configuration (required when AUTH_MODE is not 'demo')
# Generate a secure random string for production (e.g., openssl rand -base64 32)
SESSION_SECRET=change-this-to-a-secure-random-string-in-production

# OAuth Callback URL (optional, defaults to auto-detected)
# OAUTH_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# Frontend URL (optional, defaults to http://localhost:3000)
# Used for redirecting after successful authentication
# FRONTEND_URL=http://localhost:3000
